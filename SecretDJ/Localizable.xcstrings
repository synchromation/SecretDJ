            "value": "Cette action est irréversible."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dit kan niet ongedaan worden gemaakt."
          }
        }
      }
    },
    "DELETE ACCOUNT": {
      "comment": "All-caps primary button on the delete-account screen that opens the destructive confirmation dialog.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "KONTO LÖSCHEN"
          }
        },
        "es": {
