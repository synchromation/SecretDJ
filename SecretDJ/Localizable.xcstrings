    "Enter your screen name or email and we'll help you reset your password.": {
      "comment": "Explanatory body text on the forgotten-password screen.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gib deinen Benutzernamen oder deine E-Mail-Adresse ein, und wir helfen dir, dein Passwort zurückzusetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escribe tu nombre de usuario o email y te ayudaremos a restablecer tu contraseña."
