    "Everyone signing up needs one — it's how people recognize you.": {
      "comment": "Subtitle on the onboarding photo step, explaining why the photo step can't be skipped.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeder braucht eins beim Anmelden – so erkennen dich andere wieder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todo el mundo necesita una al registrarse: así te reconocerán los demás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tout le monde en a besoin à l'inscription — c'est comme ça qu'on te reconnaît."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Iedereen heeft er een nodig bij het aanmelden — zo herkennen mensen je."
          }
        }
      }
    },
