    "Check-ins, requests, and awards will show up here — check back soon.": {
      "comment": "Body of the Activity tab's placeholder, shown before the real feed exists.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hier erscheinen bald deine Check-ins, Anfragen und Auszeichnungen — schau bald wieder vorbei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aquí aparecerán tus check-ins, peticiones y premios — vuelve pronto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tes check-ins, demandes et récompenses s'afficheront ici — reviens bientôt."
