    "This can't be undone.": {
      "comment": "Message under the delete-account confirmation dialog's title, reinforcing that the action is irreversible.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
