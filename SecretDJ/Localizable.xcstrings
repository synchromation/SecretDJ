    "Sorry, we couldn't save that.\n\nPlease check that you have a good connection to your cellular data or WiFi network.": {
      "comment": "Error shown when an onboarding step (gender or avatar upload) fails, including before reaching the server.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sorry, das konnten wir nicht speichern.\n\nBitte prüfe, ob du eine gute Verbindung zu deinen mobilen Daten oder deinem WLAN hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo sentimos, no hemos podido guardar eso.\n\nComprueba que tienes una buena conexión a tus datos móviles o a la red WiFi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désolé, nous n'avons pas pu enregistrer ça.\n\nVérifie que tu as une bonne connexion à tes données mobiles ou à ton réseau WiFi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sorry, dat konden we niet opslaan.\n\nControleer of je een goede verbinding hebt met je mobiele data of wifi-netwerk."
          }
        }
      }
    },
