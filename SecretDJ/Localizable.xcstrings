    "First names can only contain letters, numbers, hyphens and apostrophes.": {
      "comment": "Inline validation message shown when the first name field fails the character-pattern check on the sign-up form.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vornamen dürfen nur Buchstaben, Zahlen, Bindestriche und Apostrophe enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los nombres solo pueden contener letras, números, guiones y apóstrofos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les prénoms ne peuvent contenir que des lettres, des chiffres, des tirets et des apostrophes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voornamen mogen alleen letters, cijfers, koppeltekens en apostrofs bevatten."
          }
        }
      }
    },
    "Forgotten Your Password?": {
      "comment": "Button on the sign-in screen that opens the forgotten-password screen; also used as that screen's title.",
      "localizations": {
        "de": {
