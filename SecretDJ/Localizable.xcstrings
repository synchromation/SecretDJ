    "Sorry, we couldn't create your account.\n\nPlease check that you have a good connection to your cellular data or WiFi network.": {
      "comment": "Error shown when sign-up fails before reaching the server (offline, timeout).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sorry, wir konnten dein Konto nicht erstellen.\n\nBitte prüfe, ob du eine gute Verbindung zu deinen mobilen Daten oder deinem WLAN hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo sentimos, no hemos podido crear tu cuenta.\n\nComprueba que tienes una buena conexión a tus datos móviles o a la red WiFi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désolé, nous n'avons pas pu créer ton compte.\n\nVérifie que tu as une bonne connexion à tes données mobiles ou à ton réseau WiFi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sorry, we konden je account niet aanmaken.\n\nControleer of je een goede verbinding hebt met je mobiele data of wifi-netwerk."
          }
        }
      }
    },
    "Sorry, we couldn't reset your password.\n\nPlease check that you have a good connection to your cellular data or WiFi network.": {
      "comment": "Error shown when a password reset request fails before reaching the server (offline, timeout).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sorry, wir konnten dein Passwort nicht zurücksetzen.\n\nBitte prüfe, ob du eine gute Verbindung zu deinen mobilen Daten oder deinem WLAN hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo sentimos, no hemos podido restablecer tu contraseña.\n\nComprueba que tienes una buena conexión a tus datos móviles o a la red WiFi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désolé, nous n'avons pas pu réinitialiser ton mot de passe.\n\nVérifie que tu as une bonne connexion à tes données mobiles ou à ton réseau WiFi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sorry, we konden je wachtwoord niet opnieuw instellen.\n\nControleer of je een goede verbinding hebt met je mobiele data of wifi-netwerk."
          }
        }
      }
    },
    "Sorry, we couldn't sign you in.\n\nPlease check that you have a good connection to your cellular data or WiFi network.": {
