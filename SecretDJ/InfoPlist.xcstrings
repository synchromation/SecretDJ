    "NSUserTrackingUsageDescription" : {
      "comment" : "App Tracking Transparency prompt, shown when the user first attempts Facebook sign-in or taps \"use my Facebook photo\" (S4.4) — the only two features that touch the Facebook SDK. Candid about what the app itself does vs. what Facebook might do, per LEGACY.md's original phrasing.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wir verfolgen dich nicht, aber wenn du dich mit Facebook anmeldest, könnten die das tun."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "We don't track you ourselves, but if you sign in with Facebook, they might."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nosotros no te rastreamos, pero si inicias sesión con Facebook, puede que ellos sí."
