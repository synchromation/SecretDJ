{
  "sourceLanguage": "en",
  "strings": {
    "Artists": {
      "comment": "Kiosk search screen tab that searches by artist name.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Künstler"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Artistas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Artistes"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Artiesten"
          }
        }
      }
    },
    "Cancel": {
      "comment": "Cancel button on the staff reset confirmation dialog.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abbrechen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cancelar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Annuler"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Annuleren"
          }
        }
      }
    },
    "Check the venue's connection and try again.": {
      "comment": "Body shown on the kiosk's jukebox wall (or a jukebox's own song list) when the device has no internet connection.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prüfe die Verbindung des Orts und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comprueba la conexión del local e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vérifie la connexion du lieu et réessaie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Controleer de verbinding van de locatie en probeer het opnieuw."
          }
        }
      }
    },
    "Downloading this venue's look": {
      "comment": "Accessibility label for the kiosk's skin-download progress bar.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Design dieses Ortes wird heruntergeladen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Descargando el diseño de este lugar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Téléchargement de l'apparence de ce lieu"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vormgeving van deze locatie wordt gedownload"
          }
        }
      }
    },
    "Getting ready": {
      "comment": "Heading shown while the kiosk downloads its venue's look after signing in.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wird vorbereitet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Preparando todo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Préparation en cours"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alles wordt klaargezet"
          }
        }
      }
    },
    "Like this song": {
      "comment": "Accessible name of the kiosk TuneIn screen's like/buzz toggle button.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diesen Song mögen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Me gusta esta canción"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "J'aime cette chanson"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dit nummer leuk vinden"
          }
        }
      }
    },
    "Never Play This": {
      "comment": "Button, shown only to entitled users, that stops a song from ever playing on the jukebox again. Never shown on a kiosk venue account (D13).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie mehr abspielen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No reproducir nunca"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ne plus jamais jouer"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nooit meer afspelen"
          }
        }
      }
    },
    "No Results": {
      "comment": "Title shown on the kiosk search screen when a search finds nothing.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keine Ergebnisse"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sin resultados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun résultat"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geen resultaten"
          }
        }
      }
    },
    "No Songs": {
      "comment": "Title shown on the kiosk when an artist has no songs here yet.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keine Songs"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sin canciones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucune chanson"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geen nummers"
          }
        }
      }
    },
    "Not Playing": {
      "comment": "Accessibility value of the kiosk TuneIn screen's preview button while no preview is playing.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wird nicht abgespielt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se está reproduciendo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pas en cours de lecture"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wordt niet afgespeeld"
          }
        }
      }
    },
    "Nothing Here Yet": {
      "comment": "Title shown on the kiosk's jukebox wall (or a jukebox's own song list) when it has no content yet.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hier gibt's noch nichts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todavía no hay nada aquí"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rien ici pour l'instant"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hier is nog niets"
          }
        }
      }
    },
    "Nothing playing yet": {
      "comment": "Shown in the kiosk's now-playing header before this venue's first song of the session.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gerade läuft nichts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nada sonando todavía"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rien ne joue pour l'instant"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Er speelt nog niets"
          }
        }
      }
    },
    "Play on the Jukebox": {
      "comment": "Button that requests the current song be played on the venue's jukebox, from the kiosk.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Auf der Jukebox abspielen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reproducir en la jukebox"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jouer sur le jukebox"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Afspelen op de jukebox"
          }
        }
      }
    },
    "Playing": {
      "comment": "Accessibility value of the kiosk TuneIn screen's preview button while the preview is playing.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wird abgespielt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reproduciendo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lecture en cours"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wordt afgespeeld"
          }
        }
      }
    },
    "Reset Kiosk": {
      "comment": "Destructive confirm button on the staff reset dialog; signs the venue out and clears kiosk caches.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kiosk zurücksetzen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reiniciar quiosco"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Réinitialiser le kiosque"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kiosk resetten"
          }
        }
      }
    },
    "Reset This Kiosk?": {
      "comment": "Title of the staff-only confirmation dialog reached by the hidden five-tap reset gesture.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diesen Kiosk zurücksetzen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Reiniciar este quiosco?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Réinitialiser ce kiosque ?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deze kiosk resetten?"
          }
        }
      }
    },
    "SIGN IN": {
      "comment": "Primary button on the kiosk's venue sign-in screen.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ANMELDEN"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "INICIAR SESIÓN"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SE CONNECTER"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "INLOGGEN"
          }
        }
      }
    },
    "SIGNING IN...": {
      "comment": "Sign-in button label while the kiosk's venue sign-in request is in flight.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ANMELDUNG..."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "INICIANDO SESIÓN..."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CONNEXION..."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "BEZIG MET INLOGGEN..."
          }
        }
      }
    },
    "Search": {
      "comment": "Label of the kiosk's search entry point — the header's search button, the search screen's navigation title, and its search field placeholder.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Suche"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Buscar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rechercher"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zoeken"
          }
        }
      }
    },
    "Setup didn't finish": {
      "comment": "Title shown when the kiosk can't download its venue skin after signing in.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Einrichtung nicht abgeschlossen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La configuración no se completó"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La configuration n'a pas abouti"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Instellen niet gelukt"
          }
        }
      }
    },
    "Skip": {
      "comment": "Button, shown only to entitled users, that skips the current song on the jukebox. Never shown on a kiosk venue account (D13).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Überspringen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saltar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Passer"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Overslaan"
          }
        }
      }
    },
    "Something Went Wrong": {
      "comment": "Title shown on the kiosk's jukebox wall (or a jukebox's own song list) when it fails to load.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Etwas ist schiefgelaufen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Algo salió mal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un problème est survenu"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Er ging iets mis"
          }
        }
      }
    },
    "Song Not Found": {
      "comment": "Title shown on the kiosk when a single-song artist's own song can't be found.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Song nicht gefunden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Canción no encontrada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chanson introuvable"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nummer niet gevonden"
          }
        }
      }
    },
    "Song Preview": {
      "comment": "Accessible name of the kiosk TuneIn screen's play/stop 30-second preview button.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Songvorschau"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vista previa de la canción"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aperçu de la chanson"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nummervoorbeeld"
          }
        }
      }
    },
    "Songs": {
      "comment": "Kiosk search screen tab that searches by song title.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Songs"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Canciones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chansons"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nummers"
          }
        }
      }
    },
    "Sorry, this account isn't set up for a venue.\n\nPlease check your venue sign-in details and try again.": {
      "comment": "Error shown when the kiosk's credentials authenticate but aren't pinned to a venue (legacy: wrong type of signin).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sorry, dieses Konto ist nicht für einen Ort eingerichtet.\n\nBitte überprüfe deine Ortsanmeldedaten und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo sentimos, esta cuenta no está configurada para un lugar.\n\nComprueba los datos de inicio de sesión del lugar e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désolé, ce compte n'est pas configuré pour un lieu.\n\nVérifie tes identifiants de connexion du lieu et réessaie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sorry, dit account is niet ingesteld voor een locatie.\n\nControleer je locatiegegevens en probeer het opnieuw."
          }
        }
      }
    },
    "Sorry, we couldn't download this venue's look. Check the connection and try again.": {
      "comment": "Body text under the kiosk skin-download failure title; a retry button follows.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sorry, wir konnten das Design dieses Ortes nicht herunterladen. Bitte prüfe die Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo sentimos, no hemos podido descargar el diseño de este lugar. Comprueba la conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désolé, nous n'avons pas pu télécharger l'apparence de ce lieu. Vérifie la connexion et réessaie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sorry, we konden de vormgeving van deze locatie niet downloaden. Controleer de verbinding en probeer het opnieuw."
          }
        }
      }
    },
    "Sorry, we couldn't find this artist's song.": {
      "comment": "Body shown on the kiosk when a single-song artist's own song can't be found.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sorry, wir konnten den Song dieses Künstlers nicht finden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo sentimos, no hemos podido encontrar la canción de este artista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désolé, nous n'avons pas trouvé la chanson de cet artiste."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sorry, we konden het nummer van deze artiest niet vinden."
          }
        }
      }
    },
    "Sorry, we couldn't load the music.\n\nPlease check the venue's connection and try again.": {
      "comment": "Body shown on the kiosk's jukebox wall (or a jukebox's own song list) when it fails to load.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sorry, wir konnten die Musik nicht laden.\n\nBitte prüfe die Verbindung des Orts und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo sentimos, no hemos podido cargar la música.\n\nComprueba la conexión del local e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désolé, nous n'avons pas pu charger la musique.\n\nVérifie la connexion du lieu et réessaie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sorry, we konden de muziek niet laden.\n\nControleer de verbinding van de locatie en probeer het opnieuw."
          }
        }
      }
    },
    "Sorry, we couldn't load these songs.\n\nPlease check the venue's connection and try again.": {
      "comment": "Body shown on the kiosk when an artist's song list fails to load.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sorry, wir konnten diese Songs nicht laden.\n\nBitte prüfe die Verbindung des Orts und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo sentimos, no hemos podido cargar estas canciones.\n\nComprueba la conexión del local e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désolé, nous n'avons pas pu charger ces chansons.\n\nVérifie la connexion du lieu et réessaie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sorry, we konden deze nummers niet laden.\n\nControleer de verbinding van de locatie en probeer het opnieuw."
          }
        }
      }
    },
    "Sorry, we couldn't play that preview. Please try again.": {
      "comment": "Toast shown when a song preview fails to download or decode, on the kiosk.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Entschuldigung, wir konnten diese Vorschau nicht abspielen. Bitte versuch es noch mal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo sentimos, no hemos podido reproducir esa vista previa. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désolé, nous n'avons pas pu lire cet aperçu. Réessaie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sorry, we konden dat voorbeeld niet afspelen. Probeer het opnieuw."
          }
        }
      }
    },
    "Sorry, we couldn't search right now.\n\nPlease check the venue's connection and try again.": {
      "comment": "Body shown on the kiosk search screen when a search fails.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sorry, wir konnten gerade nicht suchen.\n\nBitte prüfe die Verbindung des Orts und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo sentimos, no hemos podido buscar ahora mismo.\n\nComprueba la conexión del local e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désolé, nous n'avons pas pu lancer la recherche.\n\nVérifie la connexion du lieu et réessaie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sorry, we konden nu niet zoeken.\n\nControleer de verbinding van de locatie en probeer het opnieuw."
          }
        }
      }
    },
    "Sorry, we couldn't sign you in.\n\nPlease check that you have a good connection to your cellular data or WiFi network.": {
      "comment": "Error shown when kiosk venue sign-in fails before reaching the server (offline, timeout).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sorry, wir konnten dich nicht anmelden.\n\nBitte prüfe, ob du eine gute Verbindung zu deinen mobilen Daten oder deinem WLAN hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo sentimos, no hemos podido iniciar tu sesión.\n\nComprueba que tienes una buena conexión a tus datos móviles o a la red WiFi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désolé, nous n'avons pas pu te connecter.\n\nVérifie que tu as une bonne connexion à tes données mobiles ou à ton réseau WiFi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sorry, we konden je niet inloggen.\n\nControleer of je een goede verbinding hebt met je mobiele data of wifi-netwerk."
          }
        }
      }
    },
    "Tap to Continue": {
      "comment": "Visible hint and VoiceOver label on the kiosk's full-screen attract-mode screensaver; tapping anywhere dismisses it.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tippen, um fortzufahren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toca para continuar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Touche pour continuer"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik om door te gaan"
          }
        }
      }
    },
    "This artist hasn't got anything to show yet — check back soon.": {
      "comment": "Body shown on the kiosk when an artist has no songs here yet.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Künstler hat noch nichts zu zeigen — schau bald wieder vorbei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este artista todavía no tiene nada que mostrar — vuelve a comprobarlo pronto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cet artiste n'a encore rien à montrer — reviens vérifier bientôt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deze artiest heeft nog niets te laten zien — kom snel nog eens terug."
          }
        }
      }
    },
    "This signs the venue out and clears everything cached on this device. You'll need to sign in again.": {
      "comment": "Body text of the staff reset confirmation dialog, explaining what the reset does.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dadurch wird der Ort abgemeldet und alle zwischengespeicherten Daten auf diesem Gerät gelöscht. Du musst dich danach erneut anmelden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esto cierra la sesión del lugar y borra todo lo almacenado en este dispositivo. Tendrás que iniciar sesión de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cela déconnecte le lieu et efface tout ce qui est stocké sur cet appareil. Tu devras te reconnecter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hierdoor wordt de locatie uitgelogd en wordt alles wat op dit apparaat is opgeslagen, gewist. Je moet opnieuw inloggen."
          }
        }
      }
    },
    "This venue hasn't got anything to show yet — check back soon.": {
      "comment": "Body shown on the kiosk's jukebox wall (or a jukebox's own song list) when it has no content yet.",
      "localizations": {
        "de": {
          "stringUnit": {
